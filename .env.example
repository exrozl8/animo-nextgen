# ─── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Pipeline ─────────────────────────────────────────────────────────────
# Master switch. When "true", server.js auto-starts the polling loop on boot.
ENABLE_PIPELINE=false

# Nyaa RSS feed to poll. Use a filtered query, e.g.:
#   https://nyaa.si/?page=rss&c=1_0&q=subsplease
# or a specific category. Empty defaults to the main anime feed.
NYAA_RSS_URL=https://nyaa.si/?page=rss

# How often (ms) the bot polls the RSS feed. 300000 = 5 minutes.
POLL_INTERVAL_MS=300000

# Fansub release group names (lowercase, comma separated) to auto-process.
TRUSTED_GROUPS=subsplease,erai,mtbb,chibiki

# ─── AniList (metadata resolution) ───────────────────────────────────────
# Public endpoint; only change if you self-host or hit rate limits.
ANILIST_ENDPOINT=https://graphql.anilist.co

# ─── Downloads ────────────────────────────────────────────────────────────
# Where completed torrents land (Sonarr/qBittorrent output, or a custom hook).
DOWNLOAD_DIR=./downloads

# Optional external downloader hook. If set, the pipeline calls:
#   <command> "<torrent_url>" "<save_path>"
# and expects the media file path back on stdout.
DOWNLOAD_HOOK=

# qBittorrent (used by the default downloader to fetch .torrent from Nyaa link)
QBITTORRENT_HOST=http://127.0.0.1:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminpass
QBITTORRENT_LABEL=anime

# ─── Transcode ────────────────────────────────────────────────────────────
# ffmpeg must be installed and on PATH (or set absolute path below).
HLS_OUTPUT_DIR=./hls
HLS_TIME=6                      # segment duration in seconds
HLS_PLAYLIST_TYPE=vod
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac
FFMPEG_PRESET=veryfast
FFMPEG_PATH=ffmpeg

# ─── CDN / Upload ─────────────────────────────────────────────────────────
# local   -> copy into CDN_LOCAL_ROOT and serve under CDN_BASE_URL
# sftp    -> rsync over ssh to CDN_SFTP_REMOTE_DIR (requires ssh+rsync keys)
# rclone  -> rclone copy to CDN_RCLONE_REMOTE:CDN_RCLONE_DEST
# http    -> POST each file to CDN_UPLOAD_URL (returns JSON { url } or { stream_url })
UPLOAD_STRATEGY=local
CDN_BASE_URL=http://localhost:3000/hls
CDN_LOCAL_ROOT=./cdn

SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_KEY_PATH=
SFTP_REMOTE_DIR=/var/www/cdn

RCLONE_REMOTE=cdn
RCLONE_DEST=anime
RCLONE_PATH=rclone

CDN_UPLOAD_URL=
CDN_UPLOAD_HEADERS=Authorization: Bearer <token>,X-Source: animo

# ─── Database ─────────────────────────────────────────────────────────────
DB_FILE=./data/animo.db

# Token required to start/stop the pipeline over HTTP (POST /api/pipeline/start)
PIPELINE_TOKEN=changeme

# ─── Ad Monetization (Adsterra, PropellerAds, PopAds, etc.) ──────────────
# Master popunder switch & direct link / ad network script
AD_POPUNDER_ENABLED=true
AD_POPUNDER_URL=
AD_POPUNDER_INTERVAL_MIN=30

# In-page push / Social bar script URL (e.g. Adsterra social bar code)
AD_SOCIALBAR_ENABLED=false
AD_SOCIALBAR_SCRIPT=

# Player & sidebar banner ad slots (728x90 and 300x250 HTML or iframe snippet)
AD_BANNER_BOTTOM_ENABLED=true
AD_BANNER_BOTTOM_HTML=
AD_BANNER_SIDEBAR_ENABLED=true
AD_BANNER_SIDEBAR_HTML=
